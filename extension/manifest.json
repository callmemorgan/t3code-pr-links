{
  "manifest_version": 3,
  "name": "T3Code PR Links",
  "version": "2.1.0",
  "description": "Open matching T3 Code threads directly from GitHub pull requests using your paired local or remote T3 server.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "T3Code PR Links"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "Show T3 threads for the current page"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "common.js",
        "ui.js",
        "settings.js",
        "badge.js",
        "content.js",
        "list.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "123",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
